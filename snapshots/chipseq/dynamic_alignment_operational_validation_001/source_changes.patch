+def sha256(path):
+    digest = hashlib.sha256()
+
+    with Path(path).open("rb") as handle:
+        for chunk in iter(
+            lambda: handle.read(1024 * 1024),
+            b"",
+        ):
+            digest.update(chunk)
+
+    return digest.hexdigest()
+
