+def _job_status(path):
+    path = Path(path)
+
+    if not path.is_file():
+        raise ValueError(
+            f"Missing upstream alignment job status: {path}"
+        )
+
+    result = {}
+
+    for line in path.read_text(
+        encoding="utf-8"
+    ).splitlines():
+
+        if not line.strip():
+            continue
+
+        fields = line.split()
+
+        if len(fields) != 2:
+            raise ValueError(
+                f"Malformed upstream alignment job status: {line!r}"
+            )
+
+        key, value = fields
+
+        if key in result:
+            raise ValueError(
+                f"Duplicate upstream alignment job-status key: {key}"
+            )
+
+        result[key] = value
+
+    return result
+
