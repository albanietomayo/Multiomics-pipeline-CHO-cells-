localrule atacseq_filter_bam:
    input: results/metadata/validation_fastq_manifest.tsv, results/atacseq/bowtie2/SRR29929613/dupmarked.sorted.bam, results/atacseq/bowtie2/SRR29929613/dupmarked.sorted.bai
    output: results/atacseq/filtered_bam/SRR29929613/filtered.bam, results/atacseq/filtered_bam/SRR29929613/filtered.bam.bai
    jobid: 0
    reason: Input files updated by another job: results/atacseq/bowtie2/SRR29929613/dupmarked.sorted.bam, results/atacseq/bowtie2/SRR29929613/dupmarked.sorted.bai
    wildcards: run_accession=SRR29929613
    threads: 4
    resources: tmpdir=/local/tmp.10280253, mem_mb=8000, mem=8 GB, mem_mib=7630
Shell command: 
        set -euo pipefail

        mkdir -p $(dirname results/atacseq/filtered_bam/SRR29929613/filtered.bam)

        NUCLEAR_REFS=$(
            samtools idxstats results/atacseq/bowtie2/SRR29929613/dupmarked.sorted.bam \
            | awk -v mt="NC_007936.1" \
                '$1 != mt && $1 != "*" {print $1}'
        )

        if [[ "PAIRED" == "SINGLE" ]]; then
            samtools view \
              -b \
              -q 30 \
              -F 3844 \
              -o results/atacseq/filtered_bam/SRR29929613/filtered.bam \
              results/atacseq/bowtie2/SRR29929613/dupmarked.sorted.bam \
              $NUCLEAR_REFS

        elif [[ "PAIRED" == "PAIRED" ]]; then
            TMP_ROOT="${TMPDIR:-/tmp}"
            TMP_DIR=$(
                mktemp -d \
                  "$TMP_ROOT/atacseq_filter_SRR29929613.XXXXXX"
            )
            trap 'rm -rf "$TMP_DIR"' EXIT

            samtools view \
              -u \
              -q 30 \
              -f 3 \
              -F 3852 \
              results/atacseq/bowtie2/SRR29929613/dupmarked.sorted.bam \
              $NUCLEAR_REFS \
            | samtools sort \
                -n \
                -@ 4 \
                -m 750M \
                -T "$TMP_DIR/queryname" \
                -o "$TMP_DIR/candidates.name.bam" \
                -

            samtools view "$TMP_DIR/candidates.name.bam" \
            | cut -f1 \
            | uniq -c \
            | awk '$1 == 2 {print $2}' \
            > "$TMP_DIR/complete_pair_names.txt"

            test -s "$TMP_DIR/complete_pair_names.txt"

            samtools view \
              -u \
              -N "$TMP_DIR/complete_pair_names.txt" \
              "$TMP_DIR/candidates.name.bam" \
            | samtools sort \
                -@ 4 \
                -m 750M \
                -T "$TMP_DIR/coordinate" \
                -o results/atacseq/filtered_bam/SRR29929613/filtered.bam \
                -

            RECORD_COUNT=$(samtools view -c results/atacseq/filtered_bam/SRR29929613/filtered.bam)

            if (( RECORD_COUNT == 0 || RECORD_COUNT % 2 != 0 )); then
                printf 'Invalid paired ATAC-seq BAM record count: %s\n' \
                  "$RECORD_COUNT" >&2
                exit 1
            fi

        else
            printf 'Unsupported ATAC-seq structure: %s\n' \
              "PAIRED" >&2
            exit 1
        fi

        samtools quickcheck -v results/atacseq/filtered_bam/SRR29929613/filtered.bam
        samtools index results/atacseq/filtered_bam/SRR29929613/filtered.bam results/atacseq/filtered_bam/SRR29929613/filtered.bam.bai
        
